// Palmistry & Tarot Intelligence Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  role      String   @default("user") // user | reader | consultant | admin
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  palmReadings  PalmReading[]
  tarotReadings TarotReading[]
  insights      Insight[]
}

model PalmReading {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  handType     String   @default("right") // left | right
  analysis     String   // raw AI analysis (JSON)
  summary      String   // short summary
  lifeLine     String?
  heartLine    String?
  headLine     String?
  fateLine     String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TarotReading {
  id           String   @id @default(cuid())
  userId       String
  spreadType   String   // single | three-card | celtic-cross | past-present-future
  question     String?
  cardIds      String   // JSON array of card IDs in draw order
  cardOrientations String // JSON array of booleans (true=upright, false=reversed)
  interpretation String // AI interpretation
  summary      String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Insight {
  id            String   @id @default(cuid())
  userId        String
  type          String   // personality | trend | recommendation
  title         String
  content       String
  sourceReadingType String? // palm | tarot
  sourceReadingId   String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
